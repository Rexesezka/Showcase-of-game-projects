# Локальная разработка — скопируйте в .env и при необходимости измените.
DEBUG=True
SECRET_KEY=django-insecure-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Для продакшена на Render укажите PostgreSQL (Neon, Supabase или Render Postgres):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Облачное хранилище (обязательно на Render free tier):
# USE_S3_MEDIA=True
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=game-showcase-media
# AWS_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
#
# Приватный bucket (Backblaze без карты) — CUSTOM_DOMAIN не указывайте.
# Публичный bucket (R2 и т.п.) — добавьте AWS_S3_CUSTOM_DOMAIN=pub-XXXX.r2.dev
