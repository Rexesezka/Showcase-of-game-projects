# Локальная разработка — скопируйте в .env и при необходимости измените.
DEBUG=True
SECRET_KEY=django-insecure-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Для продакшена на Render укажите PostgreSQL (Neon, Supabase или Render Postgres):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Облачное хранилище для картинок и Unity-билдов (обязательно на Render free tier):
# USE_S3_MEDIA=True
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=game-showcase-media
# AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-XXXX.r2.dev
